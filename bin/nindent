#!/usr/bin/env python3
"""Indent stdin by a configurable number of spaces."""
import argparse
import sys


def parse_width(value: str) -> int:
    try:
        width = int(value, 10)
    except ValueError as exc:
        raise argparse.ArgumentTypeError("indent width must be an integer") from exc
    if width < 0:
        raise argparse.ArgumentTypeError("indent width must be non-negative")
    return width


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Read from stdin, indent each line, and write to stdout.",
    )
    parser.add_argument(
        "width",
        type=parse_width,
        help="number of leading spaces to add to each line",
    )
    args = parser.parse_args()

    indent = " " * args.width

    for line in sys.stdin:
        if indent:
            sys.stdout.write(indent + line)
        else:
            sys.stdout.write(line)

    return 0


if __name__ == "__main__":
    sys.exit(main())
